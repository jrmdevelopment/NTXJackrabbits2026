<%@ Page Title="Coaches" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="false" CodeBehind="Coaches.aspx.vb" Inherits="NTXJackrabbits2026.Coaches" %>

<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server">

    <div class="jr-page-head">
        <div class="container">
            <span class="jr-eyebrow">Meet the Staff</span>
            <h1>Coaches</h1>
        </div>
    </div>

    <section class="jr-section">
        <div class="container">
            <div class="section-head mb-4">
                <h2 class="jr-section-title">Founders &amp; Head Coaches</h2>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <div class="jr-card">
                        <div class="jr-coach-photo"><img src="<%: ResolveUrl("~/Images/Coaches/sheila_stoutmire1.jpg") %>" alt="Sheila Stoutmire" /></div>
                        <div class="card-body">
                        <h3>Sheila Stoutmire</h3>
                        <p class="mb-0">
                            Sheila graduated from Long Beach Poly High School in California. Sheila was part of
                            two CIF and State championship teams in track while attending Poly and later received
                            a full track scholarship to Louisiana State University. Sheila is a 5 time All-American
                            track athlete from Louisiana State University, which she won 4 team National
                            Championships. Sheila coaches Sprints and is USATF Certified 1.
                        </p>
                    </div></div>
                </div>
                <div class="col-md-6">
                    <div class="jr-card">
                        <div class="jr-coach-photo"><img src="<%: ResolveUrl("~/Images/Coaches/omar_stoutmire1.jpg") %>" alt="Omar Stoutmire" /></div>
                        <div class="card-body">
                        <h3>Omar Stoutmire</h3>
                        <p class="mb-0">
                            Omar graduated from Long Beach Poly High School in California. Omar is a 11 year NFL
                            veteran safety, drafted by the Dallas Cowboys in 1997. He also played on the New York
                            Giants, New Orleans Saints, and Washington Redskins. Omar coaches Sprints and is
                            USATF Certified 1 &amp; 2.
                        </p>
                    </div></div>
                </div>
            </div>

            <div class="section-head mb-4">
                <h2 class="jr-section-title">Assistant Coaches</h2>
            </div>

            <div class="row g-3">
                <div class="col-sm-6 col-lg-4">
                    <div class="jr-card">
                        <div class="jr-coach-photo"><img src="<%: ResolveUrl("~/Images/Coaches/william_warthon.jpg") %>" alt="William Warthon" /></div>
                        <div class="card-body">
                        <h3>William Warthon</h3>
                        <p class="mb-0">Long Distance Coach<br />USATF Level 1 Certified</p>
                    </div></div>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="jr-card">
                        <div class="jr-coach-photo"><img src="<%: ResolveUrl("~/Images/Coaches/bradley_fletcher.jpg") %>" alt="Bradley Fletcher" /></div>
                        <div class="card-body">
                        <h3>Bradley Fletcher</h3>
                        <p class="mb-0">Sprints Assistant Coach<br />USATF Certified Developmental Coach</p>
                    </div></div>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="jr-card">
                        <div class="jr-coach-photo"><img src="<%: ResolveUrl("~/Images/Coaches/Clifton_Brown_2018.jpg") %>" alt="Clifton Brown" /></div>
                        <div class="card-body">
                        <h3>Clifton Brown</h3>
                        <p class="mb-0">Sprints Assistant Coach<br />USATF Certified Developmental Coach</p>
                    </div></div>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="jr-card">
                        <div class="jr-coach-photo"><img src="<%: ResolveUrl("~/Images/Coaches/Jeff_Robinson1.jpg") %>" alt="Jeff Robinson" /></div>
                        <div class="card-body">
                        <h3>Jeff Robinson</h3>
                        <p class="mb-0">Sprints Assistant Coach<br />USATF Level 1 Certified</p>
                    </div></div>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="jr-card">
                        <div class="jr-coach-photo"><img src="<%: ResolveUrl("~/Images/Coaches/daryll_williams.jpg") %>" alt="Daryll Williams" /></div>
                        <div class="card-body">
                        <h3>Daryll Williams</h3>
                        <p class="mb-0">Sprints Assistant Coach<br />USATF Certified Developmental Coach</p>
                    </div></div>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="jr-card">
                        <div class="jr-coach-photo"><img src="<%: ResolveUrl("~/Images/Coaches/Dominique_Phelps1.jpg") %>" alt="Dominique Phelps" /></div>
                        <div class="card-body">
                        <h3>Dominique Phelps</h3>
                        <p class="mb-0">Sprints Assistant Coach</p>
                    </div></div>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="jr-card">
                        <div class="jr-coach-photo"><img src="<%: ResolveUrl("~/Images/Coaches/mechelle_freeman.jpg") %>" alt="Mechelle Freeman" /></div>
                        <div class="card-body">
                        <h3>Mechelle Freeman</h3>
                        <p class="mb-0">Sprints &amp; Relays Assistant Coach<br />USATF Certified Level 1 &amp; Level 2</p>
                    </div></div>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="jr-card">
                        <div class="jr-coach-photo"><img src="<%: ResolveUrl("~/Images/Coaches/miesha_jones.jpg") %>" alt="Miesha Jones" /></div>
                        <div class="card-body">
                        <h3>Miesha Jones</h3>
                        <p class="mb-0">Hurdles Coach<br />USATF Certified Developmental Coach</p>
                    </div></div>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="jr-card">
                        <div class="jr-coach-photo"><img src="<%: ResolveUrl("~/Images/Coaches/shetaya_benjamin.jpg") %>" alt="Shetaya Benjamin" /></div>
                        <div class="card-body">
                        <h3>Shetaya Benjamin</h3>
                        <p class="mb-0">Middle Distance Coach</p>
                    </div></div>
                </div>
            </div>
        </div>
    </section>

</asp:Content>
